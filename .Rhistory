library(ggplot2)
library(dplyr)
library(tidyr)
library(scales) # for formatting
df_energy_index <- read.csv("./Final_Project/Week_3_Files/Diego/Week2_deliverable/EnergyIndexUrbanHouseholdCost.csv")
df_cpi_energy <- read.csv("./Final_Project/Week_3_Files/Diego/Week2_deliverable/ConsumerPriceEnergyUSA.csv")
df_natgas_consumption <- read.csv("./Final_Project/Week_3_Files/Diego/Week2_deliverable/ResidentialEnergyInflationTrend.csv")
df_res_energy_inflation <- read.csv("./Final_Project/Week_3_Files/Diego/Week2_deliverable/ResidentialEnergyInflationTrend.csv")
merged_data <- merge(df_energy_index, df_cpi_energy, by = "DATE", all = TRUE)
merged_data <- merge(merged_data, df_natgas_consumption, by = "DATE", all = TRUE)
merged_data <- merge(merged_data, df_res_energy_inflation, by = "DATE", all = TRUE)
merged_data$DATE <- as.Date(paste0(merged_data$DATE, "-01-01"), format = "%Y-%m-%d")
# Drop rows with NA in DATE (optional, but recommended for plotting)
merged_data <- merged_data %>% drop_na(DATE)
colnames(merged_data) <- c("DATE", "Energy_Index", "CPI_Energy", "NatGas_Consumption", "Res_Energy_Inflation")
# Plotting the data
ggplot(data = merged_data, aes(x = DATE)) +
geom_line(aes(y = Energy_Index, color = "Energy Index")) +
geom_line(aes(y = CPI_Energy, color = "CPI Energy")) +
geom_line(aes(y = NatGas_Consumption, color = "Natural Gas Consumption")) +
geom_line(aes(y = Res_Energy_Inflation, color = "Residential Energy Inflation")) +
scale_color_manual(values = c("Energy Index" = "blue", "CPI Energy" = "red",
"Natural Gas Consumption" = "green", "Residential Energy Inflation" = "purple")) +
labs(title = "Trends in Energy Index and Consumption over Time",
x = "Date",
y = "Index / Consumption / Inflation Rate",
color = "Legend") +
scale_x_date(date_labels = "%Y", date_breaks = "1 year") +
theme_minimal()
# Rename columns for merging
#merged_data <- reduce(list(df_energy_index, df_cpi_energy, df_natgas_consumption, df_res_energy_inflation),
#  full_join, by = "DATE")
#merged_data <- merge(df_energy_index, df_cpi_energy, df_natgas_consumption, df_res_energy_inflation , by = "DATE")
ggplot(mydata, aes(x = GDP, y = Inflation_Rate, color = GDP)) +
geom_point(aes(size = Inflation_Rate), alpha = 0.7) +
labs(title = "Scatter Plot of GDP vs Inflation Rate",
x = "GDP (in dollars)",
y = "Inflation Rate (%)") +
scale_x_continuous(labels = comma) +  # Format x-axis with commas
scale_color_gradient(low = "lightblue", high = "darkblue", name = "GDP Value") +
theme_minimal()
##install.packages("readxl")  # Install if not already installed
library(readxl)
# Replace 'your_file.xlsx' with the path to your Excel file
mydata <- read_excel("./Final_Project/Week_3_Files/Janice/Final Project/Final_Project_copy_2.xls")
# View the first few rows of the data
head(mydata)
str(mydata)
## Load the required packages
# install.packages("ggplot2")
library(ggplot2)
# install.packages("dplyr")
library(dplyr)
library(scales)
## Renaming variables for simplicty
mydata <- mydata %>%
rename(Year = `Years (DATE)`,
Inflation_Rate = `Average of 10-Year Breakeven Inflation Rate`,
GDP = `Average of Nominal Gross Domestic Product for United States`)
## Converting 'Year' column from character to numeric
mydata$Year <- as.numeric(mydata$Year)
## Preview the dataset
head(mydata)
str(mydata)
# Create the line graph
ggplot(data = mydata, aes(x = Year, y = GDP)) +
geom_line(color = "lightblue", size = 1) +
geom_point(color = "blue", size = 1) +  # Add points on the line
labs(title = "GDP Trend in the US (Last 20 Years)",
x = "Year",
y = "Nominal GDP (in USD)") +
scale_y_continuous(labels = scales::comma) +
theme_minimal()
# Define economic downturn periods (example years)
recessions <- data.frame(
start = c(2008, 2019),  # Start of recession
end = c(2009, 2020)     # End of recession
)
# Plot the graph with shaded areas for recessions
ggplot(data = mydata, aes(x = Year, y = GDP)) +
geom_line(color = "lightblue", size = 1) +
geom_point(color = "blue", size = 1) +  # Add points on the line
geom_rect(data = recessions, aes(xmin = start, xmax = end, ymin = -Inf, ymax = Inf),
fill = "grey", alpha = 0.2, inherit.aes = FALSE) +  # Shaded areas
labs(title = "GDP Trend in the US (Last 20 Years)",
x = "Year",
y = "Nominal GDP (in USD)") +
scale_y_continuous(labels = scales::comma) +
theme_minimal()
ggplot(mydata, aes(x = GDP, y = Inflation_Rate, color = GDP)) +
geom_point(aes(size = Inflation_Rate), alpha = 0.7) +
labs(title = "Scatter Plot of GDP vs Inflation Rate",
x = "GDP (in dollars)",
y = "Inflation Rate (%)") +
scale_x_continuous(labels = comma) +  # Format x-axis with commas
scale_color_gradient(low = "green", high = "lightblue", name = "GDP Value") +
theme_minimal()
ggplot(mydata, aes(x = GDP, y = Inflation_Rate, color = GDP)) +
geom_point(aes(size = Inflation_Rate), alpha = 0.7) +
labs(title = "Scatter Plot of GDP vs Inflation Rate",
x = "GDP (in dollars)",
y = "Inflation Rate (%)") +
scale_x_continuous(labels = comma) +  # Format x-axis with commas
scale_color_gradient(low = "lightblue", high = "darkblue", name = "GDP Value") +
theme_minimal()
ggplot(mydata, aes(x = Year)) +
geom_line(aes(y = Personal_Income, color = "Personal_Income"), size = 1) +
geom_line(aes(y = Consumer_Prices * (max(mydata$Personal_Income) / max(mydata$Consumer_Prices)),
color = "Consumer_Prices"), size = 1) +
scale_y_continuous(
name = "Disposable Personal Income (in USD)",
sec.axis = sec_axis(~ . * (max(mydata$Consumer_Prices) / max(mydata$Personal_Income)),
name = "Consumer Confidence in Prices (%)")
) +
scale_color_manual(values = c("Personal_Income" = "blue", "Consumer_Prices" = "green")) +
labs(title = "Disposable Personal Income Vs. Consumer Confidence in Prices",
x = "Year") +
theme_minimal() +
theme(legend.position = "bottom")
ggplot(mydata, aes(x = factor(Year), y = 1, fill = Consumer_Prices)) +
geom_tile(color = "white") +
scale_fill_gradient(low = "lightblue", high = "darkblue", name = "Consumer Confidence in Prices") +
labs(title = "Consumer Confidence in Prices Heatmap Over Time",
x = "Year",
y = "") +
theme_minimal() +
# To organize the x-axis so everything looks neat
theme(axis.text.y = element_blank(),
axis.ticks.y = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1))
